+E9a9VAEE6zCPLmgApyxs+IKIBILVDkw4RHpY+OuzB6zqCJJcn1bqAAAAAElFTkSuQmCC") no-=
repeat left center;
}

.jobtitle {
    margin: 0;
    padding-left: 20px;
    background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQ=
CAMAAAAoLQ9TAAAAOVBMVEUAAAAkJEkXLlEWLUwWLE8XKk0WLE4YKk4YK04XK00XK0wXLE0XK00=
XK00WK00YK04XK00XK03///9JbNXBAAAAEXRSTlMABxY5Ok9SVY2ZmqrG19jZ/LOVJDkAAAABYk=
