/* module-key =3D 'confluence.web.resources:view-content', location =3D '/i=
ncludes/css/view-content.less' */
.wiki-content .confluence-embedded-file-wrapper {
=09max-width: 100%
}
.wiki-content .confluence-embedded-file-wrapper .confluence-embedded-image =
{
=09display: block;
}
.wiki-content .confluence-embedded-file-wrapper .confluence-embedded-image[=
height], .wiki-content .confluence-embedded-file-wrapper .confluence-embedd=
ed-image[width] {
=09max-width: none
}
.wiki-content .confluence-embedded-file-wrapper.confluence-embedded-manual-=
size {
=09max-width: none
}
.wiki-content .image-left-wrapper {
=09float: left;
=09margin: 0 10px 10px 0
}
.wiki-content .image-center-wrapper {
=09display: block;
=09margin-left: auto;
=09margin-right: auto
}
.wiki-content .image-center-wrapper .confluence-embedded-image{
=09margin: auto;
}
.wiki-content .image-right-wrapper {
=09float: right;
=09margin: 0 0 10px 10px
}

/* module-key =3D 'confluence.web.resources:content-styles', location =3D '=
/includes/css/tables.css' */
.confluenceTable {
=09border-collapse: collapse;
=09border-spacing: 0;
=09page-break-inside: auto;
}
.confluenceTable tr{
=09page-break-inside: avoid;
}
.confluenceTh, .confluenceTd {
=09border: 1px solid #ddd;
=09padding: 7px 10px;
=09vertical-align: top;
=09text-align: left;
=09min-width: 8px;
}
.confluenceTable ol, .confluenceTable ul {
=09margin-left: 0;
=09padding-left: 22px
}
.confluenceTable, .table-wrap {
=09margin: 10px 0 0 0;
=09overflow-x: auto
}
.confluenceTable:first-child, .table-wrap:first-child {
=09margin-top: 0
}
table.confluenceTable th.confluenceTh, table.confluenceTable th.confluenceT=
h>p, table.confluenceTable td.confluenceTd.highlight, table.confluenceTable=
 td.confluenceTd.highlight>p, table.confluenceTable th.confluenceTh.highlig=
ht-grey, table.confluenceTable th.confluenceTh.highlight-grey>p, table.conf=
luenceTable td.confluenceTd.highlight-grey, table.confluenceTable td.conflu=
enceTd.highlight-grey>p {
=09background-color: #f0f0f0
}
table.confluenceTable th.confluenceTh.info, table.confluenceTable th.conflu=
enceTh.info>p, table.confluenceTable td.confluenceTd.highlight.info, table.=
confluenceTable td.confluenceTd.highlight.info>p, table.confluenceTable th.=
confluenceTh.highlight-blue, table.confluenceTable th.confluenceTh.highligh=
t-blue>p, table.confluenceTable td.confluenceTd.highlight-blue, table.confl=
uenceTable td.confluenceTd.highlight-blue>p {
=09background-color: #e0f0ff
}
table.confluenceTable th.confluenceTh.success, table.confluenceTable th.con=
fluenceTh.success>p, table.confluenceTable td.confluenceTd.highlight.succes=
s, table.confluenceTable td.confluenceTd.highlight.success>p, table.conflue=
nceTable th.confluenceTh.highlight-green, table.confluenceTable th.confluen=
ceTh.highlight-green>p, table.confluenceTable td.confluenceTd.highlight-gre=
en, table.confluenceTable td.confluenceTd.highlight-green>p {
=09background-color: #ddfade
}
table.confluenceTable th.confluenceTh.warning, table.confluenceTable th.con=
fluenceTh.warning>p, table.confluenceTable td.confluenceTd.highlight.warnin=
g, table.confluenceTable td.confluenceTd.highlight.warning>p, table.conflue=
nceTable th.confluenceTh.highlight-red, table.confluenceTable th.confluence=
Th.highlight-red>p, table.confluenceTable td.confluenceTd.highlight-red, ta=
ble.confluenceTable td.confluenceTd.highlight-red>p {
=09background-color: #ffe7e7
}
table.confluenceTable th.confluenceTh.note, table.confluenceTable th.conflu=
enceTh.note>p, table.confluenceTable td.confluenceTd.highlight.note, table.=
confluenceTable td.confluenceTd.highlight.note>p, table.confluenceTable th.=
confluenceTh.highlight-yellow, table.confluenceTable th.confluenceTh.highli=
ght-yellow>p, table.confluenceTable td.confluenceTd.highlight-yellow, table=
.confluenceTable td.confluenceTd.highlight-yellow>p {
=09background-color: #ffd
}
table.confluenceTable th.confluenceTh, table.confluenceTable th.confluenceT=
h>p {
=09font-weight: bold
}
table.confluenceTable th.confluenceTh.nohighlight, table.confluenceTable th=
.confluenceTh.nohighlight>p {
=09font-weight: normal;
=09background-color: transparent
}
table.confluenceTable td.confluenceTd img, table.confluenceTable td.conflue=
nceTd .confluence-embedded-file-wrapper img, table.confluenceTable th.confl=
uenceTh .confluence-embedded-file-wrapper img {
=09max-width: none
}
table.confluenceTable td.numberingColumn {
=09-webkit-touch-callout: none;
=09-webkit-user-select: none;
=09-khtml-user-select: none;
=09-moz-user-select: none;
=09-ms-user-select: none;
=09user-select: none;
=09cursor: default
}

.status-macro {
=09min-width: 76px;
=09padding: 2px 5px 1px;
}
/*! AUI Lozenge */
.aui-lozenge {
=09background-color: #f1f2f4;
=09color: #405571;
=09border: 2px solid #f1f2f4;
=09border-radius: 3px;
=09display: inline-block;
=09font-size: 11px;
=09font-weight: normal;
=09/*line-height: 99%;*/
=09margin: 0;
=09padding: 0px 5px;
=09text-align: center;
=09text-decoration: none;
=09text-transform: uppercase
}
.aui-lozenge.aui-lozenge-subtle {
=09background-color: #fff;
=09border-color: #f1f2f4;
=09color: #405571
}
.aui-lozenge-success {
=09background-color: #d2fff0;
=09border-color: #d2fff0;
=09color: #00704b
}
.aui-lozenge-success.aui-lozenge-subtle {
=09background-color: #fff;
=09border-color: #d2fff0;
=09color: #00704b
}
.aui-lozenge-error {
=09background-color: #ffebeb;
=09border-color: #ffebeb;
=09color: #be1b18
}
.aui-lozenge-error.aui-lozenge-subtle {
=09background-color: #fff;
=09border-color: #ffebeb;
=09color: #be1b18
}
/* Blue on DC, yellow on CLoud */
.aui-lozenge-current {
=09background-color: #e7f2ff;
=09border-color: #e7f2ff;
=09color: #0057d4
}
.aui-lozenge-current.aui-lozenge-subtle {
=09background-color: #fff;
=09border-color: #e7f2ff;
=09color: #0054d4
}
/* Blue on Cloud */
.aui-lozenge-complete {
=09background-color: #e7f2ff;
=09border-color: #e7f2ff;
=09color: #0057d4
}
.aui-lozenge-complete.aui-lozenge-subtle {
=09background-color: #fff;
=09border-color: #e7f2ff;
=09color: #0054d4
}
.aui-lozenge-progress {
=09background-color: #f5f0ff;
=09border-color: #f5f0ff;
=09color: #614cb8
}
/* There is no subtle version of purple since it's a cloud only status */
/*.aui-lozenge-progress.aui-lozenge-subtle {
=09background-color: #fff;
=09border-color: #f3f1ff;
=09color: #614cb8
}*/
.aui-lozenge-moved {
=09background-color: #fff7d2;
=09border-color: #fff7d2;
=09color: #b24000
}
.aui-lozenge-moved.aui-lozenge-subtle {
=09background-color: #fff;
=09border-color: #fff7d2;
=09color: #b24000
}
/*! AUI Tables */
table.aui {
=09border-collapse: collapse;
=09width: 100%
}
table.aui table.aui {
=09margin: 0
}
table.aui>caption {
=09color: #707070;
=09background: #f5f5f5;
=09border-bottom: 1px solid #ccc;
=09caption-side: top;
=09padding: 7px 10px;
=09text-align: left
}
table.aui>tbody>tr>td, table.aui>tfoot>tr>td {
=09background: #fff;
=09border-bottom: 1px solid #ccc;
=09color: #333
}
table.aui>tbody>tr>th {
=09background: #fff;
=09color: #333
}
table.aui>thead>tr>th, table.aui>tbody>tr>th, table.aui>thead>tr>td, table.=
aui>tbody>tr>td, table.aui>tfoot>tr>td {
=09padding: 7px 10px;
=09text-align: left;
=09vertical-align: top
}
table.aui>thead>tr>th, table.aui>tbody>tr>th {
=09border-bottom: 1px solid #ccc
}
table.aui>tbody>tr:first-child>td, table.aui>tbody>tr:first-child>th, table=
.aui>tfoot>tr:first-child>td {
=09border-top: 1px solid #ccc
}
table.aui>thead>tr>th>ul.menu, table.aui>tbody>tr>th>ul.menu, table.aui>tbo=
dy>tr>td>ul.menu, table.aui>tfoot>tr>td>ul.menu {
=09list-style-type: none;
=09margin: 0;
=09padding: 0
}
table.aui>thead>tr>th>ul.menu>li, table.aui>tbody>tr>th>ul.menu>li, table.a=
ui>tbody>tr>td>ul.menu>li, table.aui>tfoot>tr>td>ul.menu>li {
=09float: left;
=09margin: 0 10px 0 0;
=09width: auto
}
table.aui.aui-table-interactive>tbody>tr:hover {
=09background: #f5f5f5
}
table.aui.aui-zebra tr {
=09border-bottom: 0
}
table.aui.aui-zebra>thead>tr:nth-child(even), table.aui.aui-zebra>tbody>tr:=
nth-child(even), table.aui.aui-zebra>tfoot>tr:nth-child(even), table.aui-ze=
bra>tbody>tr:nth-child(even)>th {
=09background: #f5f5f5;
=09color: #333
}
.emoticon {
=09width: 1em;
=09height: 1em;
}

.cex-highlight-macro {
    font-size: 16px;
    line-height: 24px;
    /*overflow-wrap: break-word;
    white-space: pre-wrap;*/

    padding: 0 32px;
    margin: 8px 0 0 0;
}

.confluence-highlight-macro {
    margin: 0 auto;
    padding: 8px 8px 8px 12px;
    border-radius: 3px;

    overflow: hidden;
}

.confluence-highlight-macro::after {
    display: block;
    content: "";
    clear: both;
}

.confluence-information-macro-body {
    overflow: hidden;
    float: left;
    padding-left: 8px;
    word-wrap: break-word;
}

.confluence-information-macro-body p {
    margin: 0 !important;
}

.confluence-highlight-macro:first-child {
    margin-top: 0;
}

.highlight-macro-icon {
    float: left;
    width: 24px !important;
    height: 24px !important;
    vertical-align: top;
}

