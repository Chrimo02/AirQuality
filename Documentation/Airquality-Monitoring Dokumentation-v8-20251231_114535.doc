rkJggg=3D=3D") no-repeat left center;
}

.vertical-center {
    vertical-align: center;
}

.vertical-top {
    vertical-align: top;
}

.wiki-title h1 {
    margin-bottom: 15px;
    font-size: 28px;
    line-height: 1.25;
    font-weight: normal;
}

h1 {
    letter-spacing: -.01em;
    margin-block-start: 0.67em;
    margin-block-end: 0.67em;
    margin-inline-start: 0;
    margin-inline-end: 0;
}

h2 {
    letter-spacing: -.008em;
    margin: 30px 0 0 0;
    margin-block-start: 0.83em;
    margin-block-end: 0.83em;
    margin-inline-start: 0;
    margin-inline-end: 0;
}

h3 {
    letter-spacing: -.006em;
    margin: 30px 0 0 0;
    margin-block-start: 1em;
    margin-block-end: 1em;
    margin-inline-start: 0;
    margin-inline-end: 0;
}

h4 {
    letter-spacing: -.003em;
    margin: 20px 0 0 0;
    margin-block-start: 1.33em;
    margin-block-end: 1.33em;
    margin-inline-start: 0;
    margin-inline-end: 0;
}

h5 {
    letter-spacing: 0;
    font-weight: 600;
    margin: 20px 0 0 0;
    margin-block-start: 1.67em;
    margin-block-end: 1.67em;
    margin-inline-start: 0;
    margin-inline-end: 0;
}

h6 {
    letter-spacing: 0;
    font-weight: 700;
    margin: 20px 0 0 0;
    margin-block-start: 2.33em;
    margin-block-end: 2.33em;
    margin-inline-start: 0;
    margin-inline-end: 0;
}

.wiki-content h1 {
    font-size: 1.714em;
    font-weight: normal;
    line-height: 1.166;
    margin: 0;
}

.wiki-content h2 {
    font-size: 1.43em;
    font-weight: 300;
    line-height: 1.2;
    margin-top: 1.8em;
}

.wiki-content h3 {
    font-size: 1.142em;
    font-weight: 600;
    line-height: 1.5;
    margin-top: 2em;
    margin-bottom: 0;
}

.wiki-content h4 {
    font-size: 1em;
    font-weight: 600;
    line-height: 1.428;
    margin-top: 1.357em;
}

.wiki-content h5 {
    font-size: 0.857em;
    line-height: 1.333;
    margin-top: 1.667em;
    text-transform: none;
}

.wiki-content h6 {
    font-size: 0.785em;
    line-height: 1.454;
    margin-top: 1.455em;
    text-transform: none;
}

h1, h2, h3, h4, h5 {
    text-transform: none;
}

h1, .wiki-content h1, h2, .wiki-content h2, h3, .wiki-content h3, h4, .wiki=
-content h4, h5, .wiki-content h5 {
    color: #172B4D;
}

h6, .wiki-content h6 {
    color: #626f86;
}

.wiki-content h1:first-child, .wiki-content h2:first-child, .wiki-content h=
3:first-child, .wiki-content h4:first-child, .wiki-content h5:first-child, =
.wiki-content h6:first-child {
    margin-top: 0;
}


p {
    font-size: 1em;
    line-height: 1.714;
    font-weight: normal;
    margin-top: 0.75rem;
    margin-bottom: 0;
    letter-spacing: -0.005em;

    display: block;
    margin-block-start: 1em;
    margin-block-end: 1em;
    margin-inline-start: 0;
    margin-inline-end: 0;
    unicode-bidi: isolate;
}

.wiki-content time {
    padding: 0 6px 1px 5px;
    margin: 0 1px;
    /*fix cursor is hidden at beginning of time node in FF and end of time =
node in Webkit*/
    background-color: #ebecf0;
    color: #42526e;
    border-radius: 3px;
    white-space: nowrap;
    resize: none;
    outline: 0 none;
    -webkit-touch-callout: all;
    -webkit-user-select: all;
    -khtml-user-select: all;
    -moz-user-select: all;
    -ms-user-select: all;
    user-select: all;
}

.wiki-content time:before {
    content: "";
    width: 1.143em;
    /* 16px */
    height: 1.143em;
    /* 16px */
    padding: 0;
    margin-right: 5px;
    display: inline-block;
    vertical-align: text-bottom;
    background-size: 1em;
    /* 14px width/height */
    /* Combining the below three properties into a single "background" prop=
erty disallows scaling of the icon */
    background-repeat: no-repeat;
    background-position: center;
    background-image: url("data:image/svg+xml,%3Csvg width=3D'16' height=3D=
'16' xmlns=3D'http://www.w3.org/2000/svg'%3E%3Cg fill=3D'%2397A0AF' fill-ru=
le=3D'evenodd'%3E%3Cpath d=3D'M3 6v7h10V6H3zm9-3h1a2 2 0 0 1 2 2v8a2 2 0 0 =
1-2 2H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h1V2a1 1 0 1 1 2 0v1h4V2a1 1 0 0 1 2 0=
v1z' fill-rule=3D'nonzero'/%3E%3Cpath d=3D'M4 9h2V7H4zm0 3h2v-2H4zm3-3h2V7H=
7z'/%3E%3C/g%3E%3C/svg%3E");
}
ul[data-indent-level=3D"1"], ul[data-indent-level=3D"4"] {
    list-style-type: disc;
}

ul[data-indent-level=3D"2"], ul[data-indent-level=3D"5"] {
    list-style-type: circle;
}

ul[data-indent-level=3D"3"], ul[data-indent-level=3D"6"] {
    list-style-type: square;
}

ul, ol {
    padding-left: 24px;
}
.labelsAlphaKey {
    border-bottom: 3px solid #CCC;
}

.labelList {
    vertical-align: top;
}

.labelList ul {
    list-style-type: none;
    padding: 0;
}

.labelList>li {
    margin-top: 4px;
}

.content-by-label-row {
    vertical-align: top;
}

span.content-type-page {
    background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQ=
BAMAAADt3eJSAAAAJFBMVEUAZ/8AZf8AZv8AZv8AZf8AZf8AZf84h/9VmP9yqv+rzP////+xP6f=
SAAAABnRSTlNISUvi4+TsCegUAAAAAWJLR0QLH9fEwAAAAD1JREFUCNdjUE0DA0cGNwgjmSENCp=
AY6R1AUAZkZO0GgmXIUpmrgGAaMgMulQVSCtVehmogjAG3VATCMAAAzw43x9RBxlQAAAAASUVOR=
K5CYII=3D") no-repeat;
}

ul.label-list {
    list-style: none;
    padding-left: 24px;
    margin-bottom: 4px;
}

li.aui-label {
    display: inline-block;
    margin: 0 5px 5px 0;
