.py<br />=E2=94=82 =C2=A0 =E2=94=82 =C2=A0 pytest.ini<br />=E2=94=82 =C2=A0=
 =E2=94=82 =C2=A0 requirements.txt<br />=E2=94=82 =C2=A0 =E2=94=82 =C2=A0 t=
p100_controller.py<br />=E2=94=82 =C2=A0 =E2=94=82<br />=E2=94=82 =C2=A0 =
=E2=94=9C=E2=94=80=E2=94=80 aktorik/<br />=E2=94=82 =C2=A0 =E2=94=82 =C2=A0=
 =E2=94=82 =C2=A0 air_control_rules.py<br />=E2=94=82 =C2=A0 =E2=94=82 =C2=
=A0 =E2=94=82 =C2=A0 air_quality_rating.py<br />=E2=94=82 =C2=A0 =E2=94=82 =
