.profile-macro {
    padding: 0 32px;
    margin: 8px 0 0 0;
}

.vcard {
    margin: 0 auto;
}

.userLogoLink>img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
}

.values {
    padding-left: 8px;
    word-wrap: break-word;
}

.values a {
    margin: 0 !important;
}

.user-property {
    line-height: 1 !important;
    margin: 0 !important;
}

.confluence-userlink {
    text-decoration: underline !important;
}

.email {
    padding-left: 20px;
    background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQ=
CAMAAAAoLQ9TAAAAflBMVEUAAAASJEkeLUsbKFEVK0oaLE8YKFAXLUsUKEoaLk4XK04XKk0WKU0=
