.confluence-highlight-macro-warning {
    background-color: #fdecec;
}

.confluence-highlight-macro-custom {
    background-color: #e9f2ff;
}

.confluence-information-macro-body>.title {
    font-weight: bold;
    margin: 0;
    padding: 1px 0 0 0;
}

.wiki-content .confluence-information-macro-body .confluence-embedded-file-=
wrapper .confluence-embedded-image {
    max-width: 80%;
    max-height: 80%;
}

.confluence-information-macro-information>.title>strong {
    font-weight: inherit;
}

.confluence-information-macro.empty {
    padding-left: 10px
}

.jira-issue, .unknown-jira-issue {
    background: #f5f5f5;
    border: 1px solid #ccc;
    padding: 0 0 0 2px;
    border-radius: 3px;
    display: inline-block;
    line-height: 18px;
    white-space: normal;
}

.jira-issue a img {
    margin-right: 5px;
}

.jira-issue .aui-lozenge {
    /*vertical-align: top;*/
}

.jira-issue .aui-lozenge {
    margin: 1px;
    padding: 0 5px;
}

.sectionColumnWrapper {
    display: block;
    overflow-x: auto;
}
.sectionMacro, .sectionMacroWithBorder {
    margin-top: 10px;
    display: table;
    width: 100%;
}
.sectionMacroRow {
    display: table-row;
}
.sectionMacro .columnMacro + .columnMacro {
    padding-left: 20px;
}
.sectionMacro .columnMacro {
    border: none;
    padding: 0;
}
.sectionMacroWithBorder .columnMacro {
    border-style: dashed;
    border-width: 1px;
    border-color: #ccc;
    padding: 10px;
}
.columnMacro {
    display: table-cell;
    vertical-align: top;
}

