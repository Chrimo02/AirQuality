# ┌───────────────────────────────────────────────────────────────────────────
# │ Stage 1: Build mit Node (Vite)
# └───────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# Arbeitsverzeichnis
WORKDIR /app

# Build-Args für deine VITE-Variablen
# Werte werden beim `docker build` per --build-arg übergeben
ARG VITE_USE_MOCK=false
ARG VITE_API_URL

# Setze sie als ENV, damit Vite beim Build die import.meta.env liest
ENV VITE_USE_MOCK=${VITE_USE_MOCK}
ENV VITE_API_URL=${VITE_API_URL}

# Optional: registry und retries setzen für stabile Builds
RUN npm config set registry https://registry.npmjs.org/ \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000

# Dependencies installieren
COPY package.json package-lock.json* ./
RUN npm ci

# Quellcode kopieren und builden
COPY . .
RUN npm run build
# Das Ergebnis landet in /app/dist (Standard bei Vite)


# ┌───────────────────────────────────────────────────────────────────────────
# │ Stage 2: Serve mit Nginx
# └───────────────────────────────────────────────────────────────────────────
FROM nginx:stable-alpine

# Kopiere das gebaute Frontend
COPY --from=builder /app/dist /usr/share/nginx/html

# Port freigeben
EXPOSE 80

# Nginx im Vordergrund starten
CMD ["nginx", "-g", "daemon off;"]
