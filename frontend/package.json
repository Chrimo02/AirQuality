{
  "name": "smart-home-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Air Quality Monitor Frontend (Sessions, Live WebSocket, Delta History, Device Control)",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --watch",
    "test:once": "jest --runInBand",
    "test:ci": "jest --passWithNoTests --runInBand --ci",
    "test:coverage": "jest --coverage --runInBand",
    "mutate": "stryker run",
    "analyze": "npm run lint && npm run test:once",
    "prepare": "husky install"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "classnames": "^2.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.517.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/jest-runner": "^9.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^30.0.4",
    "dotenv": "^17.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "msw": "^2.10.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "vite": "^6.3.5"
  },
  
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ]
}
